{
  "name": "agentmesh",
  "version": "0.2.0",
  "description": "Lightweight multi-agent orchestration for LLMs. Works with OpenAI and Anthropic. Pipeline → Router → Agent with priority short-circuits, session memory, and tool use.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "llm",
    "orchestration",
    "openai",
    "pipeline",
    "agentic",
    "workflow",
    "routing"
  ],
  "author": "Aarav Jain",
  "license": "MIT",
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.24.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/node": "^22.0.0",
    "openai": "^4.104.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
